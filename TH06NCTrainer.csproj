<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TH06NCTrainer</AssemblyName>
    <RootNamespace>TH06NCTrainer</RootNamespace>
    <Version>1.0.1</Version>
    <PracticeLanguage Condition="'$(PracticeLanguage)' == ''">en</PracticeLanguage>
    <DefineConstants Condition="'$(PracticeLanguage)' == 'en'">$(DefineConstants);ENGLISH</DefineConstants>
    <ApplicationIcon Condition="Exists('icons/practice.ico')">icons/practice.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/background.png" Condition="Exists('assets/background.png') And '$(IncludeLocalBackground)' != 'false'" />
  </ItemGroup>
  <Target Name="ValidatePracticeLanguage" BeforeTargets="BeforeBuild">
    <Error Condition="'$(PracticeLanguage)' != 'en' And '$(PracticeLanguage)' != 'zh-CN'" Text="PracticeLanguage must be en or zh-CN." />
  </Target>
</Project>
