<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TH06NCTrainer</AssemblyName>
    <RootNamespace>TH06NCTrainer</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon Condition="Exists('icons/practice.ico')">icons/practice.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/background.png" Condition="Exists('assets/background.png') And '$(IncludeLocalBackground)' != 'false'" />
  </ItemGroup>
</Project>
